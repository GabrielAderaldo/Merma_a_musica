# =========================================================================
# Mermã, a Música! — Exemplo de variáveis de ambiente
# =========================================================================
# Copie para `.env` e preencha. Nunca commitar `.env` (gitignorado).
# Referência completa em: handbook/doc/20-architecture/05-deployment.md
# =========================================================================

# --- Server ---------------------------------------------------------------
PORT=3000
PUBLIC_BASE_URL=https://merma.example.com
LOG_LEVEL=info

# --- Postgres (persistente) -----------------------------------------------
# Stack: Postgres 16 + Drizzle ORM — ADR-0006
POSTGRES_URL=postgres://merma:CHANGE_ME@127.0.0.1:5432/merma

# --- Redis (transiente — snapshot de partida ativa) -----------------------
# Stack: Redis 7.x — ADR-0009
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379

# --- OAuth — Spotify ------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://merma.example.com/auth/spotify/callback

# --- OAuth — Deezer -------------------------------------------------------
DEEZER_APP_ID=
DEEZER_APP_SECRET=
DEEZER_REDIRECT_URI=https://merma.example.com/auth/deezer/callback

# --- OAuth — YouTube Music (via Google OAuth) -----------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://merma.example.com/auth/youtube/callback

# --- Crypto (gerar com `openssl rand -base64 32`) -------------------------
# Sessão (cookie __Host-session)
SESSION_SECRET=
# Audio token HMAC (vide handbook/doc/30-specs/02-audio.md §2)
AUDIO_HMAC_SECRET=
# OAuth refresh tokens at rest (AES-256-GCM)
OAUTH_TOKEN_ENCRYPTION_KEY=

# --- Observabilidade ------------------------------------------------------
# Sentry DSN — opcional; off por padrão em dev local
SENTRY_DSN=
# Token Bearer para /metrics
METRICS_AUTH_TOKEN=
