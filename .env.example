# =========================================================================
# Mermã, a Música! — Exemplo de variáveis de ambiente
# =========================================================================
# Copie para `.env` e preencha. Nunca commitar `.env` (gitignorado).
# Esta é a lista canônica de variáveis (docs/operations.md e docs/security.md apontam para cá).
# Em dev, Postgres e Redis vêm da ~/.infra: `infra env` mostra as URLs.
# =========================================================================

# --- Server ---------------------------------------------------------------
PORT=3000
PUBLIC_BASE_URL=https://merma.example.com
LOG_LEVEL=info

# --- Postgres (persistente) -----------------------------------------------
# Postgres 17 + Drizzle — ADR-0006. Dev (~/.infra): postgresql://dev:dev@localhost:5432/merma
POSTGRES_URL=postgres://merma:CHANGE_ME@127.0.0.1:5432/merma

# --- Redis (transiente — snapshot de partida ativa) -----------------------
# Redis 8 — ADR-0009 (snapshot + cache ISRC). Dev (~/.infra): redis://localhost:6379
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379

# --- OAuth — Spotify (opcional, PKCE, allowlist do app) — ADR-0024 -------
# PKCE dispensa o client secret. Vazio desliga o login do Spotify.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=https://merma.example.com/auth/spotify/callback

# --- YouTube Data API (só chave, playlists públicas) — ADR-0024 ---------
YOUTUBE_API_KEY=

# --- Crypto (gerar com `openssl rand -base64 32`) -------------------------
# Sessão anônima e logada (cookie __Host-session) — ADR-0013
SESSION_SECRET=
# Audio token HMAC — ADR-0004, docs/specs/audio.md
AUDIO_HMAC_SECRET=
# OAuth refresh tokens at rest (AES-256-GCM)
OAUTH_TOKEN_ENCRYPTION_KEY=

# --- Observabilidade ------------------------------------------------------
# Sentry DSN — opcional; off por padrão em dev local
SENTRY_DSN=
# Token Bearer para /metrics
METRICS_AUTH_TOKEN=
