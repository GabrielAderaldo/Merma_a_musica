{
  "name": "merma-a-musica",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter \"*\" dev",
    "build": "bun --filter \"*\" build",
    "test": "bun test --check ./.claude/hooks ./scripts ./deploy ./apps ./packages",
    "typecheck": "bun check",
    "lint": "oxlint",
    "docs:check": "bun scripts/docs-check.ts",
    "schema:gen": "bun --filter @merma/schema generate"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "oxlint": "1.89.0",
    "typescript": "7.0.2"
  }
}
