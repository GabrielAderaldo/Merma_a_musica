# Caddy 2: TLS, estáticos e proxy para 127.0.0.1:3000 (ADR-0017, docs/operations.md).
# O Caddyfile mora em ~/.config/merma/ do usuário de serviço.
[Unit]
Description=Mermã — Caddy 2
Wants=merma-api.service
After=merma-api.service

[Container]
ContainerName=merma-caddy
Pod=merma.pod
Image=docker.io/library/caddy:2@sha256:cc447f149425221422153c6cdf33a123b3f458839679f950298f68a690a54a5b
Volume=%h/.config/merma/Caddyfile:/etc/caddy/Caddyfile:ro
Volume=merma-caddydata.volume:/data
Volume=merma-caddyconfig.volume:/config
HealthCmd=wget -q -O /dev/null http://127.0.0.1:2019/config/
HealthInterval=10s
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
