{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun install)",
      "Bash(bun install --frozen-lockfile)",
      "Bash(bun test:*)",
      "Bash(bun run lint:*)",
      "Bash(bun run build:*)",
      "Bash(bun --filter:*)",
      "Bash(bunx oxlint:*)",
      "Bash(bun check:*)",
      "Bash(bun run typecheck:*)",
      "Bash(bunx @hono/cli docs:*)",
      "Bash(bunx @hono/cli search:*)",
      "Bash(bunx @hono/cli request:*)",
      "Bash(bun run docs:check)",
      "Bash(bun run test:*)",
      "WebFetch(domain:code.claude.com)",
      "mcp__acdg-skills",
      "mcp__security",
      "mcp__reverse-proxy",
      "mcp__bun-docs",
      "WebFetch(domain:bun.com)",
      "WebFetch(domain:hono.dev)",
      "WebFetch(domain:docs.solidjs.com)",
      "WebFetch(domain:orm.drizzle.team)",
      "WebFetch(domain:zod.dev)",
      "WebFetch(domain:oxc.rs)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:redis.io)",
      "WebFetch(domain:docs.sentry.io)",
      "WebFetch(domain:www.postgresql.org)",
      "WebFetch(domain:caddyserver.com)",
      "WebFetch(domain:developer.spotify.com)",
      "WebFetch(domain:developers.deezer.com)",
      "WebFetch(domain:www.typescriptlang.org)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          { "type": "command", "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-env.ts" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-accepted-adr.ts" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.ts" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gate-stop.ts", "timeout": 120 }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "acdg-skills",
    "security",
    "reverse-proxy",
    "bun-docs"
  ],
  "enabledPlugins": {
    "hono@hono": true,
    "redis-development@claude-plugins-official": true,
    "dart-flutter@dart-flutter": false,
    "swift-lsp@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "hono": {
      "source": {
        "source": "github",
        "repo": "honojs/skills"
      }
    }
  }
}
